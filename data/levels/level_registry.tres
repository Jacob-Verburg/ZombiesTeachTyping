[gd_resource type="Resource" script_class="LevelRegistry" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/level_registry.gd" id="1_registry"]
[ext_resource type="Script" path="res://scripts/resources/level_entry.gd" id="2_entry"]
[ext_resource type="PackedScene" path="res://scenes/levels/test_level/test_level.tscn" id="3_test_level"]
[ext_resource type="PackedScene" path="res://scenes/levels/zombie_run/zombie_run_level.tscn" id="4_zombie_run"]

[sub_resource type="Resource" id="Resource_zombie_run"]
script = ExtResource("2_entry")
